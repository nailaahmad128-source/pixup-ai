// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g.,
// pubspec.yaml) in the future. If not, ensure elements from AppInfo.xcconfig
// are used from the Info.plist to correctly reflect app metadata.

// The application's name. By default this is also the executable's name.
PRODUCT_NAME = pixup_ai

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.pixupai.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.pixupai.app. All rights reserved.
